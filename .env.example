# OpenAI API key — project-scoped key from platform.openai.com/api-keys
# Use the "MCP Building" project key for nomad-toronto-av codex work.
# Never commit the actual .env file (it is gitignored).
OPENAI_API_KEY=sk-proj-...

# Codex ImageGen settings (optional overrides)
CODEX_IMAGEGEN_MODEL=gpt-image-2
CODEX_IMAGEGEN_MAX_ITER=5
CODEX_IMAGEGEN_QUALITY_THRESHOLD=7
