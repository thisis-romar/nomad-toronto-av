{
  "name": "nomad-toronto-av",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "NØMAD Toronto AV — monorepo (audio + lighting disciplines, stakeholder portal)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "gh:setup": "node tooling/gh-project-setup.js",
    "gh:sync": "node tooling/gh-project-sync.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "dependency-cruiser": "^16.4.2",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "workerd"]
  }
}
